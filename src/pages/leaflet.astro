---
import Card from "../components/Card.astro";
import Layout from "../layouts/Layout.astro";
import "leaflet/dist/leaflet.css";
---

<Layout
  title="Carte des établissements"
  description="Carte Leaflet des établissements de l'enseignement supérieur. Cliquez sur un marqueur pour afficher son nom."
>
  <Card>
    <figure>
      <div
        id="map"
        role="region"
        aria-label="Carte interactive des établissements"
        class="isolate h-[600px] w-full overflow-hidden rounded-lg border border-slate-200"
      >
      </div>
      <figcaption class="mt-2 text-sm text-slate-500">
        Localisation des établissements de l'enseignement supérieur.
      </figcaption>
    </figure>
  </Card>
</Layout>

<script>
  import listeEtablissements from "../assets/listeEtablissements.json";
  import L from "leaflet";
  import markerIcon from "leaflet/dist/images/marker-icon.png";
  import markerIcon2x from "leaflet/dist/images/marker-icon-2x.png";
  import markerShadow from "leaflet/dist/images/marker-shadow.png";

  // L.Icon.Default casse les chemins d'images générés par Vite
  const icone = L.icon({
    iconUrl: markerIcon.src,
    iconRetinaUrl: markerIcon2x.src,
    shadowUrl: markerShadow.src,
    iconSize: [25, 41],
    iconAnchor: [12, 41],
    popupAnchor: [1, -34],
    shadowSize: [41, 41],
  });

  const map = L.map("map").setView([46.6033, 1.883], 6);

  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(map);

  for (const { name, lat, lon } of listeEtablissements) {
    if (lat == null || lon == null) continue;
    L.marker([lat, lon], { icon: icone, title: name, alt: name }).addTo(map).bindPopup(name);
  }
</script>
