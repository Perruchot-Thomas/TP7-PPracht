---
import Card from "../../components/Card.astro";
import FiltresPopulation from "../../components/FiltresPopulation.astro";
import PlotFigure from "../../components/PlotFigure.astro";
import Layout from "../../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import departements from "../../assets/departements.geojson.json";
import { listeAge, listePeriode, listeSexe, optionsCarte } from "../../lib/population";

// Page rendue à chaque requête (SSR) pour lire les paramètres du formulaire
export const prerender = false;

const params = Astro.url.searchParams;
const selectedYear = listePeriode.includes(Number(params.get("year"))) ? Number(params.get("year")) : listePeriode[0];
const selectedSex = listeSexe.includes(params.get("sex") ?? "") ? params.get("sex")! : listeSexe[0];
const selectedAge = listeAge.includes(params.get("age") ?? "") ? params.get("age")! : listeAge[0];
---

<Layout
  title="Population par département (serveur)"
  description="La carte est générée sur le serveur avec Observable Plot et jsdom. Chaque changement de filtre recharge la page avec les nouveaux paramètres."
>
  <Card titre="Filtres">
    <FiltresPopulation year={selectedYear} sex={selectedSex} age={selectedAge} serveur />
  </Card>

  <Card>
    <PlotFigure options={optionsCarte(Plot, departements, selectedYear, selectedSex, selectedAge)} />
  </Card>
</Layout>
