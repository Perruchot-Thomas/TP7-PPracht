---
import Card from "../../components/Card.astro";
import FiltresPopulation from "../../components/FiltresPopulation.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Population par département (client)"
  description="La carte est recalculée dans le navigateur à chaque changement de filtre, sans recharger la page."
>
  <Card titre="Filtres">
    <FiltresPopulation />
  </Card>

  <Card>
    <div id="carte" aria-live="polite" class="overflow-x-auto"></div>
  </Card>
</Layout>

<script>
  import * as Plot from "@observablehq/plot";
  import departements from "../../assets/departements.geojson.json";
  import { existe, optionsCarte } from "../../lib/population";

  const elmYear = document.getElementById("periode") as HTMLSelectElement;
  const elmSex = document.getElementById("sexe") as HTMLSelectElement;
  const elmAge = document.getElementById("age") as HTMLSelectElement;
  const elmCarte = document.getElementById("carte") as HTMLDivElement;

  function majOptions() {
    for (const o of elmYear.options) o.disabled = !existe(Number(o.value), elmSex.value, elmAge.value);
    for (const o of elmSex.options) o.disabled = !existe(Number(elmYear.value), o.value, elmAge.value);
    for (const o of elmAge.options) o.disabled = !existe(Number(elmYear.value), elmSex.value, o.value);
  }

  function draw() {
    majOptions();
    const selectedYear = Number(elmYear.value);
    const selectedSex = elmSex.value;
    const selectedAge = elmAge.value;

    const plot = Plot.plot(optionsCarte(Plot, departements, selectedYear, selectedSex, selectedAge) as Plot.PlotOptions);
    elmCarte.replaceChildren(plot);
  }

  [elmYear, elmSex, elmAge].forEach((elm) => elm.addEventListener("change", draw));
  draw();
</script>
