---
import Card from "./Card.astro";
import FiltresPopulation from "./FiltresPopulation.astro";
import PlotFigure from "./PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import departements from "../assets/departements.geojson.json";
import { optionsCarte } from "../lib/population";

const { year, sex, age } = Astro.props;
---

<Layout
  title="Population par département (serveur)"
  description="La carte est générée côté serveur avec Observable Plot et jsdom, au moment du build : une page HTML par combinaison de filtres. Changer un filtre ouvre la page correspondante."
>
  <Card titre="Filtres">
    <FiltresPopulation year={year} sex={sex} age={age} serveur />
  </Card>

  <Card>
    <PlotFigure options={optionsCarte(Plot, departements, year, sex, age)} />
  </Card>
</Layout>
