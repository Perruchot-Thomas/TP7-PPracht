---
import { existe, listeAge, listePeriode, listeSexe, urlServeur } from "../lib/population";

const { year = listePeriode[0], sex = listeSexe[0], age = listeAge[0], serveur = false } = Astro.props;

const selectClass =
  "rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200";
const labelClass = "flex flex-col gap-1 text-sm font-medium text-slate-700";
---

<form class="grid items-end gap-4 sm:grid-cols-3" aria-label="Filtres de la carte" data-serveur={serveur ? "" : undefined}>
  <label class={labelClass}>
    Année
    <select id="periode" name="year" class={selectClass}>
      {listePeriode.map((p) => <option selected={p === year} disabled={!existe(p, sex, age)} data-url={urlServeur(p, sex, age)}>{p}</option>)}
    </select>
  </label>
  <label class={labelClass}>
    Sexe
    <select id="sexe" name="sex" class={selectClass}>
      {listeSexe.map((s) => <option selected={s === sex} disabled={!existe(year, s, age)} data-url={urlServeur(year, s, age)}>{s}</option>)}
    </select>
  </label>
  <label class={labelClass}>
    Âge
    <select id="age" name="age" class={selectClass}>
      {listeAge.map((a) => <option value={a} selected={a === age} disabled={!existe(year, sex, a)} data-url={urlServeur(year, sex, a)}>{a.trim()}</option>)}
    </select>
  </label>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("form[data-serveur]");
  form?.addEventListener("change", (e) => {
    const url = (e.target as HTMLSelectElement).selectedOptions[0]?.dataset.url;
    if (url) window.location.href = url;
  });
</script>
