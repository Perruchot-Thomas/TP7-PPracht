---
import "../styles/global.css";
import { pages } from "../data/pages";
const { title = "TP7 - Astro, Plot et Leaflet", description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-indigo-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Aller au contenu
    </a>

    <header class="sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur">
      <nav
        aria-label="Navigation principale"
        class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-3"
      >
        <a href="/" class="text-lg font-bold text-indigo-700 hover:text-indigo-900">TP7</a>
        <ul class="flex flex-wrap gap-1 text-sm font-medium">
          {
            pages.map((p) => (
              <li>
                <a
                  href={p.href}
                  aria-current={path === p.href || path.startsWith(p.href + "/") ? "page" : undefined}
                  class="rounded-lg px-3 py-2 text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 aria-[current=page]:bg-indigo-50 aria-[current=page]:text-indigo-700"
                >
                  {p.titre}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="contenu" class="mx-auto max-w-5xl space-y-8 px-4 py-10">
      <div class="space-y-2">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">{title}</h1>
        {description && <p class="max-w-2xl text-slate-600">{description}</p>}
      </div>
      <slot />
    </main>

    <footer class="border-t border-slate-200 py-6 text-center text-sm text-slate-500">
      TP7 · Astro, Observable Plot et Leaflet
    </footer>
  </body>
</html>
